{
  "rootDir": "..",
  "testRegex": "test/.*[.]e2e-spec[.]ts$",
  "moduleFileExtensions": ["js", "json", "ts"],
  "transform": { "^.+[.](t|j)s$": ["ts-jest", { "tsconfig": "<rootDir>/tsconfig.json" }] },
  "moduleNameMapper": { "^@/(.*)$": "<rootDir>/src/$1", "^@test/(.*)$": "<rootDir>/test/$1" },
  "testEnvironment": "node"
}
