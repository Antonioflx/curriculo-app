# Backend (NestJS). Copie para `.env` e preencha. NUNCA commite o `.env`.
# Cada app tem o próprio .env (o frontend terá o dele em frontend/.env).

NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:3000

# Banco local (Docker). O docker-compose só importa estas três variáveis (pnpm db:up).
# Para trocar a senha de um banco já criado: pnpm db:down -v (apaga os dados locais).
POSTGRES_USER=curriculo
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=curriculo
# Mantenha igual aos POSTGRES_* acima. Em produção (Neon) use a URL do provedor com sslmode=require.
DATABASE_URL=postgresql://curriculo:troque-esta-senha@localhost:5432/curriculo

# Segredo do JWT. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Em produção, o valor de exemplo abaixo é recusado no boot.
JWT_SECRET=troque-por-um-segredo-com-no-minimo-32-caracteres

# IA (as chaves NUNCA vão para o código nem para o git; só aqui, no .env)
# Provider principal e, opcionalmente, um alternativo para quando o principal fica indisponível
# (cota, 5xx, timeout, chave ou modelo inválidos). O Groq só atende texto (não recebe a imagem da vaga).
# Modelos mudam e são aposentados rápido: reavalie com `pnpm --filter backend ai:bench` (docs/ia.md).
LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Modelo reserva do Gemini, usado quando o principal esgota as tentativas por sobrecarga ou cota. Opcional.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Timeout de cada TENTATIVA à IA, em ms (1000 a 120000).
AI_TIMEOUT_MS=30000
# Orçamento TOTAL de uma chamada à IA (tentativas, esperas e fallback), em ms (5000 a 300000).
# Deve caber no maxDuration da função na Vercel.
AI_TOTAL_TIMEOUT_MS=60000
